{
  "expo": {
    "name": "Voylo",
    "slug": "voylo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voylo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.voylo.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.voylo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@sentry/react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Voylo needs your location while a Voyage is active so your group can see you on the map.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.23.1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c17e355c-3a95-453e-940a-9fb2145c8f44"
      }
    },
    "owner": "pointmax"
  }
}
